{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "A clean, documented REST API over the Urja Meter Ops distribution metering portal. Exposes meter nameplates, time-series consumption readings, distribution transformers, reconstructed network hierarchy, geospatial radius search, and caching without requiring direct portal access.",
    "contact": {
      "name": "Urja API Engineering",
      "url": "https://github.com/flock-energy/urja-api"
    },
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "API Service Index",
        "description": "Index of available API resources and documentation links.",
        "operationId": "api_index_api_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Api Index Api Get"
                }
              }
            }
          }
        }
      }
    },
    "/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List / search meters",
        "description": "Returns a paginated list of meters. Pass `q` to search by meter ID or serial number prefix. 20 results per page.",
        "operationId": "list_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search term (meter ID or serial number prefix)",
              "default": "",
              "title": "Q"
            },
            "description": "Search term (meter ID or serial number prefix)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedMeters"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/query": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Advanced multi-attribute meter search",
        "description": "Answers questions the legacy portal cannot answer: filter meters across manufacturer (make), phase type (single/three), installation status, distribution transformer (dt_code), feeder, or zone.",
        "operationId": "query_meters_meters_query_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search substring in meter ID or serial number",
              "default": "",
              "title": "Q"
            },
            "description": "Search substring in meter ID or serial number"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by make (e.g. HPL, Genus, L&T)",
              "title": "Make"
            },
            "description": "Filter by make (e.g. HPL, Genus, L&T)"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase (single or three)",
              "title": "Phase Type"
            },
            "description": "Filter by phase (single or three)"
          },
          {
            "name": "install_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status (Commissioned, Decommissioned, Pending)",
              "title": "Install Status"
            },
            "description": "Filter by status (Commissioned, Decommissioned, Pending)"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by DT code (e.g. DT-001)",
              "title": "Dt Code"
            },
            "description": "Filter by DT code (e.g. DT-001)"
          },
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by feeder code (e.g. F-001)",
              "title": "Feeder Code"
            },
            "description": "Filter by feeder code (e.g. F-001)"
          },
          {
            "name": "zone_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone code (e.g. Z-01)",
              "title": "Zone Code"
            },
            "description": "Filter by zone code (e.g. Z-01)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedMeters"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/nearby": {
      "get": {
        "tags": [
          "spatial"
        ],
        "summary": "Find meters near GPS coordinates",
        "description": "Computes great-circle distances using the Haversine formula and returns all meters within radius_km of the given latitude/longitude, sorted nearest first.",
        "operationId": "get_meters_nearby_meters_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Target latitude (e.g. 26.9124)",
              "title": "Lat"
            },
            "description": "Target latitude (e.g. 26.9124)"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Target longitude (e.g. 75.7873)",
              "title": "Lon"
            },
            "description": "Target longitude (e.g. 75.7873)"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 50.0,
              "exclusiveMinimum": 0.0,
              "description": "Radius in kilometers (default 5km)",
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Radius in kilometers (default 5km)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Maximum results to return",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/stats": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Fleet analytics and network breakdown",
        "description": "Returns aggregated metrics across the entire distribution network: active vs decommissioned ratio, single vs three phase distribution, breakdown by manufacturer make, and distribution transformers.",
        "operationId": "get_network_stats_meters_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkStats"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get full meter detail",
        "description": "Returns nameplate parameters, network hierarchy (Zone \u2192 Feeder \u2192 DT), and GPS coordinates for the specified meter.",
        "operationId": "get_meter_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/energy": {
      "get": {
        "tags": [
          "consumption"
        ],
        "summary": "Meter consumption readings",
        "description": "Returns all available time-series energy readings for the meter. Each record contains timestamp, cumulative active energy (kWh), apparent energy (kVAh), and R-phase voltage.",
        "operationId": "get_meter_energy_meters__meter_id__energy_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnergyReading"
                  },
                  "title": "Response Get Meter Energy Meters  Meter Id  Energy Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transformers": {
      "get": {
        "tags": [
          "transformers"
        ],
        "summary": "List distribution transformers",
        "description": "Returns a paginated list of distribution transformers (DTs). 20 per page.",
        "operationId": "list_dts_transformers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedDTs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/network": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Reconstructed network hierarchy",
        "description": "Reconstructs the complete distribution network topology from meter records: Zone \u2192 Circle \u2192 Division \u2192 Subdivision \u2192 Substation \u2192 Feeder \u2192 DT \u2192 Meters. Served with low-latency caching.",
        "operationId": "get_network_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Network Network Get"
                }
              }
            }
          }
        }
      }
    },
    "/sync": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Force refresh local cache from portal",
        "description": "Triggers a fresh bulk export from the Urja portal and updates the local query index.",
        "operationId": "force_sync_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatus"
